# Get a free API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_google_ai_studio_api_key_here

# Flash-Lite is optimized for high-volume agentic tasks; higher-capability models are fallbacks.
GEMINI_MODEL=gemini-3.5-flash-lite

# Automatic fallback models if the primary model hits a temporary 503/429 spike
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.6-flash

# Bound slow requests so the trip-planning call cannot wait forever
GEMINI_REQUEST_TIMEOUT_MS=120000
AGENT_RUN_TIMEOUT_SECONDS=300

# Allowed frontend origin for CORS
CORS_ORIGINS=http://localhost:5173

# OpenStreetMap public endpoints (no API keys; use a descriptive User-Agent)
OSM_USER_AGENT=AITravelAgent/0.1 (local travel planning app)
NOMINATIM_URL=https://nominatim.openstreetmap.org
OVERPASS_URL=https://overpass-api.de/api/interpreter
OVERPASS_FALLBACK_URL=https://overpass.private.coffee/api/interpreter
OVERPASS_REQUEST_TIMEOUT_SECONDS=4
OSRM_DRIVING_URL=https://router.project-osrm.org
OSRM_FOOT_URL=https://routing.openstreetmap.de/routed-foot
CACHE_DB_PATH=data/api_cache.sqlite3
